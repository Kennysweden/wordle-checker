 field.addEventListener('focus',()=>{selectRow(i);editing=field.value.length>0;previous=field.value});
 field.addEventListener('input',event=>{
  field.value=field.value.replace(/[^a-z]/gi,'').slice(0,5).toUpperCase();check();
  const complete=!editing&&previous.length<5&&field.value.length===5&&!event.isComposing;
  previous=field.value;
  if(complete)moveNext(i);
