  button.textContent=key==='BACK'?'⌫':key==='NEXT'?'Next':key;
  button.setAttribute('aria-label',key==='BACK'?'Backspace':key==='NEXT'?'Next word':key);
  button.addEventListener('pointerdown',e=>e.preventDefault());
  button.addEventListener('click',()=>keyPress(key));
  row.append(button);
 }
}

 const lastFilled=fields.reduce((last,f,i)=>f.value?i:last,-1);
