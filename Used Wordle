 function resumeAtNext(){
  // Never take focus away from someone already editing a word.
  if(document.activeElement&&document.activeElement.classList?.contains('word')){selectRow(fields.indexOf(document.activeElement));return;}
  let next=fields.findIndex(f=>!f.value);
  if(next<0)next=MAX_ROWS-1;
  revealThrough(next);
  selectRow(next);fields[next].focus({preventScroll:true});
  requestAnimationFrame(()=>keepVisible(fields[next]));
