const fields=[],statuses=[];
let selectedIndex=0;
// On touch screens the built-in keyboard replaces the native keyboard.
const touchKeyboard=('ontouchstart' in window)||navigator.maxTouchPoints>0;
function selectRow(i){
 selectedIndex=Math.max(0,Math.min(MAX_ROWS-1,i));
 fields.forEach((f,j)=>f.classList.toggle('selected',j===selectedIndex));
 keepVisible(fields[selectedIndex]);
}

 const MAX_ROWS=30;
 let visibleRows=1;
const storageKey='wordle-checker-entries';
let savedEntries=[];
try{const stored=JSON.parse(localStorage.getItem(storageKey)||'[]');if(Array.isArray(stored))savedEntries=stored}catch{}
function saveEntries(){try{localStorage.setItem(storageKey,JSON.stringify(fields.map(f=>f.value)))}catch{}}
function check(){
 let entered=0,found=0;
 fields.forEach((field,i)=>{
  const raw=field.value,match=lookup.get(raw.toLowerCase()),status=statuses[i];
  status.className='status';status.textContent='';
  if(!raw)return;
  entered++;
  if(raw.length!==5){status.textContent='5 letters needed';status.classList.add('extra')}
  else if(match){found++;status.textContent=match===match.toLowerCase()?'Yes – Wordle Only':'Already Used';status.classList.add('yes')}
  else{status.textContent='Not on list';status.classList.add('no')}
 });
 saveEntries();
 summary.textContent=entered?`${found} of ${entered} on the list.`:'Ready for up to 30 words.';
}
function revealThrough(index){
  if(index>=visibleRows){
   visibleRows=Math.min(MAX_ROWS,index+1);
   fields.forEach((f,j)=>{f.closest('tr').hidden=j>=visibleRows});
  }
 }
 function moveNext(i){
  if(i<MAX_ROWS-1){revealThrough(i+1);selectRow(i+1);fields[i+1].focus({preventScroll:true});keepVisible(fields[i+1])}
 }
for(let i=0;i<MAX_ROWS;i++){
 const row=document.createElement('tr'),number=document.createElement('td'),cell=document.createElement('td'),status=document.createElement('td'),field=document.createElement('input');
