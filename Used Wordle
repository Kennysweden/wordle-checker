  const text=event.clipboardData.getData('text'),tokens=text.trim().split(/[\s,;]+/).filter(Boolean);
  if(tokens.length<2)return;
  event.preventDefault();let j=i;
  for(const token of tokens){if(j>=MAX_ROWS)break;fields[j++].value=token.replace(/[^a-z]/gi,'').slice(0,5).toUpperCase()}
  check();revealThrough(Math.min(j,MAX_ROWS-1));fields[Math.min(j,MAX_ROWS-1)].focus({preventScroll:true});keepVisible(fields[Math.min(j,MAX_ROWS-1)]);
 });
